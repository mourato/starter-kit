{
    "name": "@starter/server",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun run --hot src/index.ts",
        "build": "tsdown src/index.ts --format esm --clean",
        "start": "bun run dist/index.mjs",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --passWithNoTests",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "bun run src/db/migrate.ts"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.6",
        "@hono/trpc-server": "^0.4.0",
        "@starter/contracts": "workspace:*",
        "@starter/shared": "workspace:*",
        "@trpc/server": "^11.0.0",
        "drizzle-orm": "^0.45.4",
        "hono": "^4.8.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/bun": "^1.3.9",
        "drizzle-kit": "^0.31.11",
        "tsdown": "^0.23.7",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    }
}
